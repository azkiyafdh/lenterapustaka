# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional passcode to claim or unlock librarian admin registration
ADMIN_PASSCODE=""

# Optional server-side session signing secret (defaults to ephemeral random bytes if unset)
SESSION_SECRET=""

# Optional SMTP configuration for real automated Email return reminders
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Lentera Pustaka <noreply@lenterapustaka.id>"

# Optional WhatsApp Gateway / Webhook URL for real automated WhatsApp reminders
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_API_TOKEN=""
